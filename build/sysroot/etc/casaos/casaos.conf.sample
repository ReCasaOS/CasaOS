[app]
PAGE_SIZE = 10
RuntimeRootPath = runtime/
LogPath = /var/log/casaos/
LogSaveName = log
LogFileExt = log
DateStrFormat = 20060102
DateTimeFormat = 2006-01-02 15:04:05
TimeFormat = 15:04:05
DateFormat = 2006-01-02
DBPath     = /var/lib/casaos
ShellPath  = /usr/share/casaos/shell
UserDataPath = /var/lib/casaos/conf

[server]
RunMode = release
Token = 
USBAutoMount =
UpdateUrl = https://github.com/ReCasaOS/CasaOS-Install/releases/latest/download/install.sh
UpdateVersionUrl = https://github.com/ReCasaOS/CasaOS-Install/releases/latest/download/version.json

[system]

[file]
; directories the file API may browse, read, write and delete in, comma-separated
; (e.g. /DATA,/mnt,/media); empty: anywhere on the machine
ManagementRoots =
