# ===== blocks/verify.sh
# casaos-os-upgrade verify 6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13
set -eu
LC_ALL=C; export LC_ALL
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
AUTOCLASS=unknown
osu_exit() { rc=$?; [ "$rc" -eq 0 ] || printf '%s\n' "$AUTOCLASS" > "${CASAOS_OSU_DIR:-/nonexistent}/stop-class"; }
trap osu_exit EXIT
[ "${CASAOS_OSU_RUN:-}" = '6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13' ] && grep -q 'casaos-os-upgrade\.service' /proc/self/cgroup || { AUTOCLASS=unit; echo "STOP: this block belongs to the upgrade unit of the dashboard and runs only there, with the confirmation of the owner baked in: to continue by hand use manual-runbook.sh of the run."; exit 1; }
BK=/var/backups/casaos-os-upgrade-p1-5787acb2f81006785a3076312615ae6c
[ ! -e "$BK/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over (block 8 ended: done-after is in $BK): there is nothing more to run in this text."; exit 1; }
for fin in /var/backups/casaos-os-upgrade-*; do
  [ ! -e "$fin/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over for this machine: the plan whose folder is $fin took it to the end (block 8 ended: done-after is there), and there is nothing more to run in this text."; exit 1; }
done
export DEBIAN_FRONTEND=noninteractive APT_LISTCHANGES_FRONTEND=none NEEDRESTART_SUSPEND=1
aptq() { apt-get -y -q -o Dpkg::Use-Pty=0 -o DPkg::Lock::Timeout=300 -o Acquire::Retries=3 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"; }
TYPED_HOSTNAME='testbox'
echo "Block 0: is this the machine of the plan? Nothing is changed."
[ "$(id -u)" = 0 ] || { AUTOCLASS=identity; echo "STOP: run this as root."; exit 1; }
if [ -e "$BK/begun-upgrade" ] || [ -e "$BK/done-minimal" ]; then
  AUTOCLASS=identity; echo "STOP: the upgrade has begun (block 5 was started): this block is for before it. Do not restore anything. Only forward: finish with dpkg --configure -a, then apt-get -f install, then block 6 and the blocks after it (the table at the end of the runbook has the exact commands)."
  exit 1
fi
if [ -e "$BK/apt-orig" ]; then
  if [ -e "$BK/done-sources" ]; then
    AUTOCLASS=integrity; echo "STOP: block 3 has begun and ended ($BK/done-sources is there): the sources of apt are Debian 12's now, and this block is for before it. The next is block 4. To start again from block 3, put the sources back first: sh $BK/restore-sources.sh   (it forgets blocks 3 and 4)."
  else
    AUTOCLASS=integrity; echo "STOP: block 3 has begun and did not end ($BK/apt-orig is there): the sources of apt may no longer be the ones that the plan was made from, and this block is for before it. Look at the table at the end of this text: sh $BK/restore-sources.sh puts the sources back (when that file is there), and block 3 can then be run again."
  fi
  exit 1
fi
for d in /var/backups/casaos-os-upgrade-*; do
  if [ -e "$d/begun-upgrade" ] || [ -e "$d/done-minimal" ]; then
    AUTOCLASS=identity; echo "STOP: another plan of this machine has begun the upgrade of the packages ($d has begun-upgrade): Debian 11 and 12 are mixed there, and nothing in this text applies to it. Do not restore anything, and do not make another plan: finish that upgrade. Only forward: DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold   then:   DEBIAN_FRONTEND=noninteractive apt-get -s -f install   (read it first: a line that starts with Remv is a package that it would remove; if it is one that the plan does not name, or one that this text protects, do not go on and ask for help)   then:   DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -f install   then:   apt-get dist-upgrade until nothing is left, and restart. Or ask for help."
    exit 1
  fi
  if [ -e "$d/apt-orig" ]; then
    if [ -f "$d/restore-sources.sh" ]; then
      AUTOCLASS=identity; echo "STOP: block 3 of another plan of this machine began ($d/apt-orig is there), so the sources of apt may no longer be the ones that this plan was made from. Put them back first: sh $d/restore-sources.sh   (it puts the sources back as they were and takes apt-orig aside), then run this block again."
    else
      AUTOCLASS=identity; echo "STOP: block 3 of another plan of this machine began ($d/apt-orig is there), and $d/restore-sources.sh is not. apt-orig is the whole copy of /etc/apt that it made before it changed anything: compare it with /etc/apt, put back by hand what differs, rename apt-orig, then run this block again."
    fi
    exit 1
  fi
done
[ -n "$TYPED_HOSTNAME" ] && [ "$TYPED_HOSTNAME" = "$(hostname)" ] || { AUTOCLASS=identity; echo "STOP: this machine is called $(hostname). Type that name between the quotes of TYPED_HOSTNAME at the top of this block, to show that you are on the machine you mean to upgrade."; exit 1; }
[ "$(date +%s)" -lt 1791883800 ] || { AUTOCLASS=plan; echo "STOP: this plan is older than its 24 hours (it was good until 2026-10-13 09:30 UTC): the machine may have changed. Ask for a new plan."; exit 1; }
grep -q '^VERSION_CODENAME=bullseye$' /etc/os-release || { AUTOCLASS=identity; echo "STOP: this machine is not Debian 11 (bullseye) any more: the plan does not apply. Ask for a new one."; exit 1; }
audit="$(dpkg --audit 2>&1)" && [ -z "$audit" ] || { AUTOCLASS=dpkg_broken; echo "STOP: dpkg is not quiet: it has a package that is half installed or half configured, or it cannot open its own database. dpkg --audit says: ${audit:-nothing, but it ended with an error}. Run: dpkg --configure -a   then ask for a new plan. If dpkg cannot open its own database, ask for help."; exit 1; }
command -v ss > /dev/null 2>&1 || { AUTOCLASS=tools; echo "STOP: ss is not installed: blocks 2 and 8 use it to write down the ports that listen. Install it: apt-get install iproute2   then run this block again."; exit 1; }
command -v curl > /dev/null 2>&1 || { AUTOCLASS=tools; echo "STOP: curl is not installed: block 8 uses it to ask whether Docker publishes its repository for bookworm. Install it: apt-get install curl   then run this block again."; exit 1; }
psout="$(ps -eo comm=,args= 2> /dev/null)" || { AUTOCLASS=tools; echo "STOP: ps did not answer, so the processes cannot be looked at for a package manager. If ps is not installed: apt-get install procps   then run this block again."; exit 1; }
busy="$(printf '%s\n' "$psout" | awk '
$1 == "apt" || $1 == "apt-get" || $1 == "aptitude" || $1 == "apt.systemd.dai" { $1 = $1; print substr($0, 1, 120); exit }
$1 == "dpkg" { for (i = 2; i <= NF; i++) if ($i ~ /^(-i|-r|-P|--install|--configure|--unpack|--remove|--purge|--triggers-only)$/) { $1 = $1; print substr($0, 1, 120); exit } }
$2 ~ /\/unattended-upgrade$/ || ($2 ~ /(^|\/)python[0-9.]*$/ && $3 ~ /\/unattended-upgrade$/) { $1 = $1; print substr($0, 1, 120); exit }
' | tr -cd '\040-\176')"
[ -z "$busy" ] || { AUTOCLASS=busy; echo "STOP: a package manager is running (the process list says: $busy): wait until it ends. This check looks at the processes, not at the file locks of apt and dpkg: the apt-get commands of this text that check, download or install wait up to 5 minutes for the dpkg lock and stop if it stays held, and apt-get update does not wait for the lock of the lists."; exit 1; }
aptq check > /dev/null || { AUTOCLASS=dpkg_broken; echo "STOP: apt-get check finds a broken dependency, or could not get the lock of dpkg in 5 minutes (what it printed above says which): repair it, or wait for the other package manager, then run this block again. If it is a broken dependency, ask for a new plan once it is repaired."; exit 1; }
avail() { df -Pk "$1" | awk 'NR == 2 { print $4 }'; }
[ "$(avail '/var/cache/apt/archives')" -ge 674679 ] || { AUTOCLASS=disk; echo "STOP: /var/cache/apt/archives needs 659 MB free for this plan, and has less. Free some room there (apt-get clean empties the cache of downloaded packages; remove what you do not need), then run this block again."; exit 1; }
[ "$(avail '/usr')" -ge 1488030 ] || { AUTOCLASS=disk; echo "STOP: /usr needs 1454 MB free for this plan, and has less. Free some room there (apt-get clean empties the cache of downloaded packages; remove what you do not need), then run this block again."; exit 1; }
[ "$(avail '/')" -ge 524288 ] || { AUTOCLASS=disk; echo "STOP: / needs 513 MB free for this plan, and has less. Free some room there (apt-get clean empties the cache of downloaded packages; remove what you do not need), then run this block again."; exit 1; }
isinst() { case "$(dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2> /dev/null || true)" in ii*) return 0 ;; esac; return 1; }
[ "$(avail /boot)" -ge 307200 ] || { AUTOCLASS=disk; echo "STOP: /boot has less than 300 MiB free: the new kernel and its initrd are written there, and dpkg fails in the middle of block 6, after the point of no return, when there is no room. Free some room there (a kernel that you do not use any more, for example), then run this block again."; exit 1; }
if [ -d /sys/firmware/efi ]; then
  grep -q ' /boot/efi ' /proc/mounts || { AUTOCLASS=barrier_grub; echo "STOP: this machine starts with UEFI and the EFI system partition is not mounted on /boot/efi: GRUB would be written in the wrong place, or not at all. Mount it (see /etc/fstab), then run this block again."; exit 1; }
  [ "$(avail /boot/efi)" -ge 16384 ] || { AUTOCLASS=disk; echo "STOP: /boot/efi has less than 16 MiB free: GRUB's files are written there again. Free some room, then run this block again."; exit 1; }
elif isinst grub-pc; then
  devices="$(echo get grub-pc/install_devices | debconf-communicate 2> /dev/null | awk 'NR == 1 { $1 = ""; gsub(/[ ,]/, ""); print }' || true)"
  if [ -z "$devices" ]; then
    [ "$(echo get grub-pc/install_devices_empty | debconf-communicate 2> /dev/null | awk 'NR == 1 { print $2 }' || true)" = true ] || { AUTOCLASS=barrier_grub; echo "STOP: grub-pc has no disk to be installed on (grub-pc/install_devices is empty), and its update ends in error in block 6, where there is no terminal to ask it. Set it first: dpkg-reconfigure grub-pc   then run this block again."; exit 1; }
  fi
fi
# the sources of apt are the ones the plan was made from
srchash() {
  nl="$(printf '\nx')"; nl="${nl%x}"
  ( cd /etc/apt
  for f in sources.list sources.list.d/*; do
    [ -f "$f" ] || continue
    case "$f" in
      sources.list) ;;
      sources.list.d/*)
        name="${f#sources.list.d/}"
        case "$name" in *"$nl"*) continue ;; esac
        printf '%s\n' "$name" | grep -Eq '^[A-Za-z0-9_:-][A-Za-z0-9_:.-]*\.(list|sources)$' || continue ;;
    esac
    n="$(wc -c < "$f")"
    printf '%s\0%s\0' "$f" "$((n))"
    cat "$f"
    printf '\0'
  done ) | sha256sum | awk '{ print $1 }'
}
now="$(srchash)"
[ "$now" = '35d17f59fd0705980471e5e52dcf6f54e2292d8b14e245051b88f45539ebcb8a' ] || { AUTOCLASS=plan; echo "STOP: the sources of apt are not the ones the plan was made from: something changed them. Ask for a new plan."; exit 1; }
if command -v dkms > /dev/null 2>&1 && [ -n "$(dkms status 2> /dev/null || true)" ]; then echo "WARNING: dkms has modules built from source on this machine (dkms status lists them). Block 6 builds them again for the new kernel, and a driver that does not build for it is a driver that is missing after the restart (a network card, a disk controller). This is NOT a stop: check by hand that each one supports the kernel of bookworm before you go on."; fi
mkdir -p -m 700 "$BK"; chmod 700 "$BK"
: > "$BK/done-verify"
echo "Block 0 done."
# ===== blocks/timers.sh
# casaos-os-upgrade timers 6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13
