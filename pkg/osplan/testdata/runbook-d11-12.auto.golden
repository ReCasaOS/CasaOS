[ "$before" = "$now" ] || { AUTOCLASS=barrier_other; echo "STOP: the iptables alternative is not the one of block 2 (before: ${before:-none}, now: ${now:-none}): the rules of the firewall and of Docker use it. Fix: update-alternatives --set iptables ${before:-the-one-of-before}   then run this block again."; exit 1; }
