if [ -e "$BK/begun-upgrade" ] || [ -e "$BK/done-minimal" ]; then AUTOCLASS=identity; echo "STOP: the upgrade has begun (block 5 was started): this block would replace the state of before the upgrade, which blocks 7 and 8 compare with, by the state of now. Do not restore anything. Only forward: finish with dpkg --configure -a, then apt-get -f install, then block 6 and the blocks after it (the table at the end of the runbook has the exact commands)."; exit 1; fi
for m in sources download minimal full prereboot after; do
  [ ! -e "$BK/done-$m" ] || { AUTOCLASS=integrity; echo "STOP: a later block has ended (done-$m is in $BK): running this one again would replace the state of the machine as it was with the state of now, and blocks 7 and 8 compare with the first. Do not run it again."; exit 1; }
done
[ ! -e "$BK/apt-orig" ] || { AUTOCLASS=integrity; echo "STOP: block 3 has begun (apt-orig is in $BK): the sources may not be the ones of before. If they are not, run sh $BK/restore-sources.sh first, then this block."; exit 1; }
echo "Block 2: writing down the state of the machine in $BK."
dpkg --get-selections > "$BK/selections.txt"
dpkg-query -W -f='${db:Status-Abbrev}\t${Package}\t${Version}\n' > "$BK/packages.tsv"
awk -F'\t' '$1 ~ /^h/ { print $2 }' "$BK/packages.tsv" > "$BK/holds.txt"
[ ! -e /var/lib/apt/extended_states ] || cp -p /var/lib/apt/extended_states "$BK/extended_states"
rc=0
( umask 077; tar -C / -czf "$BK/etc.tar.gz" etc ) || rc=$?
case "$rc" in
  0) ;;
