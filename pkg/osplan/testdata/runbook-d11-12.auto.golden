BK=/var/backups/casaos-os-upgrade-p1-5787acb2f81006785a3076312615ae6c
[ ! -e "$BK/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over (block 8 ended: done-after is in $BK): there is nothing more to run in this text."; exit 1; }
for fin in /var/backups/casaos-os-upgrade-*; do
  [ ! -e "$fin/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over for this machine: the plan whose folder is $fin took it to the end (block 8 ended: done-after is there), and there is nothing more to run in this text."; exit 1; }
done
[ -e "$BK/begun-upgrade" ] || [ -e "$BK/done-minimal" ] || grep -q '^VERSION_CODENAME=bullseye$' /etc/os-release || { AUTOCLASS=identity; echo "STOP: the hop is over for this machine: it is not Debian 11 (bullseye) any more, and this plan did not begin the upgrade of its packages (neither begun-upgrade nor done-minimal is in $BK): another plan, or the owner by hand, took it on, and nothing in this text applies to it. If another plan of this machine has not ended (ls /var/backups), go on with that one."; exit 1; }
[ -e "$BK/done-verify" ] || { AUTOCLASS=integrity; echo "STOP: the block before this one (verify) did not end: run it first (ls $BK shows how far you got)."; exit 1; }
mkdir -p -m 700 "$BK"; chmod 700 "$BK"
TS=/var/backups/casaos-os-upgrade-timers.state
echo "Block 1: stopping the timers of apt."
if [ -e "$TS" ]; then
  echo "$TS is there from an earlier run of this block (by this plan or by another): the state of the timers that it holds is the one of before the hop, and it is kept."
else
  ( umask 077; : > "$TS.$$" )
  for unit in apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service; do
    printf '%s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)" >> "$TS.$$"
  done
  if ! ln "$TS.$$" "$TS" 2> /dev/null; then
    if [ -e "$TS" ]; then
      echo "$TS was put in place by another run of this block while this one was reading the timers: the state of that run is the one that is kept."
    else
      echo "ln could not put $TS in place (a file system with no hard links, or no room for one more entry): the state that this run wrote down is kept by a rename instead."
      mv -f "$TS.$$" "$TS" || { rm -f "$TS.$$"; AUTOCLASS=disk; echo "STOP: the state of the timers could not be put in $TS (is the disk full: df -h /var/backups): without it block 8 would start no timer. Free some room, then run this block again."; exit 1; }
    fi
  fi
  rm -f "$TS.$$"
fi
: > "$BK/timers-stopping"
sync
for unit in apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service; do
  if [ "$(systemctl is-active "$unit" 2>/dev/null || true)" = active ]; then systemctl stop "$unit"; fi
  [ "$(systemctl is-active "$unit" 2>/dev/null || true)" != active ] || { AUTOCLASS=busy; echo "STOP: $unit is still running: stop it (systemctl stop $unit), then run this block again."; exit 1; }
done
: > "$BK/done-timers"
echo "Block 1 done."
