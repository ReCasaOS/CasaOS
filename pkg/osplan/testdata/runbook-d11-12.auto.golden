esac
ss -Hltn | awk '{ print $4 }' | sort > "$BK/listening.txt"
: > "$BK/sshd-keys.txt"
if command -v sshd > /dev/null 2>&1; then
  [ -d /run/sshd ] || mkdir -p -m 755 /run/sshd
  sshd -T 2> /dev/null | grep -E '^(port|listenaddress|permitrootlogin|passwordauthentication|pubkeyacceptedkeytypes|pubkeyacceptedalgorithms) ' | sort > "$BK/sshd-keys.txt" || true
fi
update-alternatives --query iptables 2> /dev/null | awk '/^Value:/ { print $2 }' > "$BK/iptables-alternative.txt"
systemctl --failed --no-legend --plain 2> /dev/null | awk '{ print $1 }' | sort > "$BK/failed-units.txt" || true
systemctl list-units 'casaos*' --all --no-legend --plain 2> /dev/null | awk '{ print $1, $3 }' | sort > "$BK/casaos-units.txt" || true
: > "$BK/containers.txt"
if command -v docker > /dev/null 2>&1 && [ -S /run/docker.sock ]; then
  ids="$(docker ps -aq 2> /dev/null || true)"
  if [ -n "$ids" ]; then docker inspect --format '{{.Name}} policy={{.HostConfig.RestartPolicy.Name}} state={{.State.Status}}' $ids > "$BK/containers.txt" 2>&1 || true; fi
fi
find / -xdev \( -name '*.dpkg-old' -o -name '*.dpkg-new' -o -name '*.dpkg-dist' -o -name '*.ucf-*' \) 2> /dev/null | sort > "$BK/dpkg-files.txt" || true
for f in selections.txt packages.tsv etc.tar.gz listening.txt; do [ -s "$BK/$f" ] || { AUTOCLASS=disk; echo "STOP: $BK/$f was not written: is the disk full (df -h /var/backups)? See what the commands above printed, free some room, then run this block again."; exit 1; }; done
