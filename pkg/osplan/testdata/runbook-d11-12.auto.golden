  [ -d /run/sshd ] || mkdir -p -m 755 /run/sshd
  sshd -t || { AUTOCLASS=barrier_sshd; echo "STOP: sshd does not accept its configuration: the machine would not be reachable after a boot. What sshd -t printed above says which file and which line; put it right, then run this block again."; exit 1; }
  sshd -T 2> /dev/null | grep -E '^(port|listenaddress|permitrootlogin|passwordauthentication) ' | sort > "$BK/sshd-keys-now.txt" || true
  grep -E '^(port|listenaddress|permitrootlogin|passwordauthentication) ' "$BK/sshd-keys.txt" | sort > "$BK/sshd-keys-before.txt" || true
  [ "$(cat "$BK/sshd-keys-before.txt")" = "$(cat "$BK/sshd-keys-now.txt")" ] || { AUTOCLASS=barrier_sshd; echo "STOP: the settings of sshd (port, address, root login, passwords) are not the ones of before: compare $BK/sshd-keys.txt with sshd -T."; exit 1; }
  echo "The algorithms that sshd accepts for keys are named differently by Debian 12, and its defaults changed: look at them yourself."
  echo "  before:  $(grep -E '^pubkeyaccepted' "$BK/sshd-keys.txt" || echo none)"
  echo "  now:     $(sshd -T 2> /dev/null | grep -E '^pubkeyaccepted' || echo none)"
fi
if [ "$early" = yes ]; then
  echo "NOT checked: /etc/fstab and the mounts (findmnt --verify), the names of the network cards, that Docker answers, that your applications work. Look at them yourself: the machine has started, so you can."
  printf '%s\n' "$newest" > "$BK/kernel"
  : > "$BK/done-prereboot"
  echo "Block 7 done."
  echo "The machine has started on the new kernel already, so it needs no restart for this. Go on with block 8."
  exit 0
fi
echo "NOT checked: /etc/fstab and the mounts (findmnt --verify), the names of the network cards, that Docker answers, that your applications work. Look at them yourself before you restart."
printf '%s\n' "$newest" > "$BK/kernel"
cat /proc/sys/kernel/random/boot_id > "$BK/boot_id"
: > "$BK/done-prereboot"
echo "Block 7 done."
if [ "$warned" = yes ]; then echo "The checks above passed, except what the WARNING above says (the size of the initrd, or the boot loader): look at it by hand first. What this block does not check is yours too. When you have looked, restart the machine yourself, with the console at hand. This text does not do it."
else echo "The checks above passed. What this block does not check (the NOT checked line above) is yours: look at it first. When you have, restart the machine yourself, with the console at hand. This text does not do it."; fi
# ===== blocks/after.sh
# casaos-os-upgrade after 6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13
set -eu
LC_ALL=C; export LC_ALL
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
AUTOCLASS=unknown
osu_exit() { rc=$?; [ "$rc" -eq 0 ] || printf '%s\n' "$AUTOCLASS" > "${CASAOS_OSU_DIR:-/nonexistent}/stop-class"; }
trap osu_exit EXIT
[ "${CASAOS_OSU_RUN:-}" = '6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13' ] && grep -q 'casaos-os-upgrade\.service' /proc/self/cgroup || { AUTOCLASS=unit; echo "STOP: this block belongs to the upgrade unit of the dashboard and runs only there, with the confirmation of the owner baked in: to continue by hand use manual-runbook.sh of the run."; exit 1; }
BK=/var/backups/casaos-os-upgrade-p1-5787acb2f81006785a3076312615ae6c
[ ! -e "$BK/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over (block 8 ended: done-after is in $BK): there is nothing more to run in this text."; exit 1; }
for fin in /var/backups/casaos-os-upgrade-*; do
  [ ! -e "$fin/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over for this machine: the plan whose folder is $fin took it to the end (block 8 ended: done-after is there), and there is nothing more to run in this text."; exit 1; }
done
[ -e "$BK/begun-upgrade" ] || [ -e "$BK/done-minimal" ] || grep -q '^VERSION_CODENAME=bullseye$' /etc/os-release || { AUTOCLASS=identity; echo "STOP: the hop is over for this machine: it is not Debian 11 (bullseye) any more, and this plan did not begin the upgrade of its packages (neither begun-upgrade nor done-minimal is in $BK): another plan, or the owner by hand, took it on, and nothing in this text applies to it. If another plan of this machine has not ended (ls /var/backups), go on with that one."; exit 1; }
[ -e "$BK/done-prereboot" ] || { AUTOCLASS=integrity; echo "STOP: the block before this one (prereboot) did not end: run it first (ls $BK shows how far you got)."; exit 1; }
mkdir -p -m 700 "$BK"; chmod 700 "$BK"
export DEBIAN_FRONTEND=noninteractive APT_LISTCHANGES_FRONTEND=none NEEDRESTART_SUSPEND=1
aptq() { apt-get -y -q -o Dpkg::Use-Pty=0 -o DPkg::Lock::Timeout=300 -o Acquire::Retries=3 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"; }
APT_ETC=/etc/apt
echo "Block 8: after the restart."
rm -f "$BK/docker-source-note"
if [ -s "$BK/boot_id" ]; then
  [ "$(cat /proc/sys/kernel/random/boot_id)" != "$(cat "$BK/boot_id")" ] || { AUTOCLASS=identity; echo "STOP: the machine has not been restarted since block 7: restart it first."; exit 1; }
fi
grep -q '^VERSION_CODENAME=bookworm$' /etc/os-release || { AUTOCLASS=identity; echo "STOP: this machine is not Debian 12 (bookworm): see the console, and the table at the end of this text."; exit 1; }
want="$(cat "$BK/kernel" 2> /dev/null || true)"
[ -n "$want" ] || { AUTOCLASS=integrity; echo "STOP: $BK/kernel is not there: block 7 writes it, and it did not end. Run block 7 first."; exit 1; }
[ "$(uname -r)" = "$want" ] || { AUTOCLASS=barrier_kernel; echo "STOP: the machine runs the kernel $(uname -r), not $want, the one block 7 looked at: it started on the old one (grub's default, or a choice in its menu). Fix: choose $want in the boot menu on the console, make it the default (GRUB_DEFAULT=0 in /etc/default/grub, or grub-set-default 0 when it is saved), run update-grub, restart, and run this block again."; exit 1; }
cat "$APT_ETC/sources.list" "$APT_ETC"/sources.list.d/*.list 2> /dev/null | grep -Eq '^[[:space:]]*deb(-src)?[[:space:]].*bookworm' || { AUTOCLASS=identity; echo "STOP: the sources of apt do not name bookworm: they are not the ones block 3 wrote (the restore script run after the upgrade, or a change by hand). Write Debian 12's sources again as block 3 does (its text has them), run apt-get update, then run this block again."; exit 1; }
echo "The machine runs: $(grep '^PRETTY_NAME=' /etc/os-release), kernel $(uname -r)."
systemctl --failed --no-legend --plain 2> /dev/null | awk '{ print $1 }' | sort > "$BK/failed-units-after.txt" || true
echo "--- units that fail now and did not before the hop (block 2 wrote down the ones that failed before, in $BK/failed-units.txt):"
comm -13 "$BK/failed-units.txt" "$BK/failed-units-after.txt" || true
echo "--- all the units that fail now:"
systemctl --failed --no-legend --plain || true
echo "--- the ReCasaOS units now, and as they were before the hop (unit and state):"
systemctl list-units 'casaos*' --all --no-legend --plain || true
echo "  before:"
cat "$BK/casaos-units.txt" || true
echo "--- containers now, and what they were before:"
if command -v docker > /dev/null 2>&1; then docker ps -a --format '{{.Names}} {{.Status}}' || true; fi
if [ -s "$BK/containers.txt" ]; then cat "$BK/containers.txt"; else echo "(there were none)"; fi
ss -Hltn | awk '{ print $4 }' | sort > "$BK/listening-after.txt"
echo "--- ports that listened before the hop and do not now (a service may start a little after the machine does):"
comm -23 "$BK/listening.txt" "$BK/listening-after.txt" || true
echo "--- ports that listen now and did not before:"
comm -13 "$BK/listening.txt" "$BK/listening-after.txt" || true
audit="$(dpkg --audit 2>&1)" && [ -z "$audit" ] || { AUTOCLASS=dpkg_broken; echo "STOP: dpkg is not quiet: it has a package that is half installed or half configured, or it cannot open its own database. dpkg --audit says: ${audit:-nothing, but it ended with an error}. Run dpkg --configure -a, then run this block again."; exit 1; }
# the timers, as they were (block 1 wrote them down, in a file outside the folder of the plan)
TS=/var/backups/casaos-os-upgrade-timers.state
if [ -f "$TS" ]; then
  while read -r unit state; do
    if [ "$state" = active ]; then systemctl start "$unit"; fi
  done < "$TS"
else
  echo "$TS is not there, so no timer of apt is started: if they were running before the hop, start them: systemctl start apt-daily.timer apt-daily-upgrade.timer"
fi
# Docker's source goes back, for Debian 12, when Docker publishes Debian 12. curl says which it is: 0 it does; 22 it answers with an error status, which is
# 'not published' for 403, 404 and 410 and the server's own trouble for the others (429, 5xx); anything else is the network (6 no name, 7 no connection, 28 too
# slow) or no curl, and is no answer.
rc=0
code=000
if command -v curl > /dev/null 2>&1; then code="$(curl -fsI --connect-timeout 10 --max-time 30 -o /dev/null -w '%{http_code}' https://download.docker.com/linux/debian/dists/bookworm/InRelease)" || rc=$?; else rc=127; fi
if [ "$rc" = 0 ]; then
  f="$APT_ETC/sources.list.d/docker.list"
  if [ -e "$f.casaos-paused" ]; then
    ( umask 022; awk '/^[ \t]*#/ { print; next } { for (i = 1; i <= NF; i++) if ($i == "bullseye") $i = "bookworm"; print }' "$f.casaos-paused" > "$f.casaos-new" )
    mv -f "$f.casaos-new" "$f"
    rm -f "$f.casaos-paused"
  fi
elif [ "$rc" = 22 ] && { [ "$code" = 404 ] || [ "$code" = 403 ] || [ "$code" = 410 ]; }; then
  echo "Docker publishes nothing for bookworm yet (download.docker.com answered the status $code for its Release file): its source stays paused."
  printf '%s\n' not_published > "$BK/docker-source-note"
  echo 'To put Docker'\''s source back by hand, when it is published: mv /etc/apt/sources.list.d/docker.list.casaos-paused /etc/apt/sources.list.d/docker.list   then:   sed -i "s/ bullseye / bookworm /" /etc/apt/sources.list.d/docker.list   then:   apt-get update'
elif [ "$rc" = 22 ]; then
  echo "download.docker.com answered the error status $code, which does not say that it publishes nothing (429 and 5xx are the server's own trouble, and pass): Docker's source stays paused, and the upgrade goes on without it. It is said in the report."
  printf '%s\n' unreachable > "$BK/docker-source-note"
  echo 'To put Docker'\''s source back by hand, when it is published: mv /etc/apt/sources.list.d/docker.list.casaos-paused /etc/apt/sources.list.d/docker.list   then:   sed -i "s/ bullseye / bookworm /" /etc/apt/sources.list.d/docker.list   then:   apt-get update'
elif [ "$rc" = 127 ]; then
  echo "curl is not installed, so Docker's repository cannot be asked about bookworm: its source stays paused, and the upgrade goes on without it. It is said in the report."
  printf '%s\n' no_curl > "$BK/docker-source-note"
  echo 'To put Docker'\''s source back by hand, when it is published: mv /etc/apt/sources.list.d/docker.list.casaos-paused /etc/apt/sources.list.d/docker.list   then:   sed -i "s/ bullseye / bookworm /" /etc/apt/sources.list.d/docker.list   then:   apt-get update'
else
  echo "curl could not reach download.docker.com (exit $rc: 6 no name, 7 no connection, 28 too slow): the network is probably not up yet. Docker's source stays paused, and the upgrade goes on without it. It is said in the report."
  printf '%s\n' unreachable > "$BK/docker-source-note"
  echo 'To put Docker'\''s source back by hand, when it is published: mv /etc/apt/sources.list.d/docker.list.casaos-paused /etc/apt/sources.list.d/docker.list   then:   sed -i "s/ bullseye / bookworm /" /etc/apt/sources.list.d/docker.list   then:   apt-get update'
fi
aptq update || echo "apt-get update did not go through (another package manager may hold the lock of the lists: apt-get update does not wait for it): run it again."
find / -xdev \( -name '*.dpkg-old' -o -name '*.dpkg-new' -o -name '*.dpkg-dist' -o -name '*.ucf-*' \) 2> /dev/null | sort > "$BK/dpkg-files-after.txt" || true
echo "Files that dpkg left beside the ones you edited, and that were not there when block 2 looked (a .dpkg-dist is the new version of a file of yours that was NOT installed over it: compare it with yours; sshd, samba and the defaults of grub are the ones to look at):"
comm -13 "$BK/dpkg-files.txt" "$BK/dpkg-files-after.txt" || true
echo "  (all of them, the old ones too: $BK/dpkg-files-after.txt)"
echo "Then update Docker from the dashboard (System packages), and look at your applications."
echo "Do not run apt autoremove without looking: apt says that some packages are no longer needed, and the list can hold a package that this text protects (net-tools was in it in the measured hop). Run apt-get -s autoremove first, and keep what you need: apt-mark manual <the name>."
rm -f "$TS"
: > "$BK/done-after"
echo "Block 8 done."
echo "That is not to say that the machine is healthy: the steps ran. Read the lists above (the units that fail, the ports, the containers, the files of dpkg) and look at your applications."
# ===== blocks/forward.sh
# casaos-os-upgrade forward 6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13
set -eu
LC_ALL=C; export LC_ALL
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
AUTOCLASS=unknown
osu_exit() { rc=$?; [ "$rc" -eq 0 ] || printf '%s\n' "$AUTOCLASS" > "${CASAOS_OSU_DIR:-/nonexistent}/stop-class"; }
trap osu_exit EXIT
[ "${CASAOS_OSU_RUN:-}" = '6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13' ] && grep -q 'casaos-os-upgrade\.service' /proc/self/cgroup || { AUTOCLASS=unit; echo "STOP: this block belongs to the upgrade unit of the dashboard and runs only there, with the confirmation of the owner baked in: to continue by hand use manual-runbook.sh of the run."; exit 1; }
BK=/var/backups/casaos-os-upgrade-p1-5787acb2f81006785a3076312615ae6c
[ ! -e "$BK/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over (block 8 ended: done-after is in $BK): there is nothing more to run in this text."; exit 1; }
for fin in /var/backups/casaos-os-upgrade-*; do
  [ ! -e "$fin/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over for this machine: the plan whose folder is $fin took it to the end (block 8 ended: done-after is there), and there is nothing more to run in this text."; exit 1; }
done
export DEBIAN_FRONTEND=noninteractive APT_LISTCHANGES_FRONTEND=none NEEDRESTART_SUSPEND=1
aptq() { apt-get -y -q -o Dpkg::Use-Pty=0 -o DPkg::Lock::Timeout=300 -o Acquire::Retries=3 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"; }
removed_of() { awk '/^The following packages will be REMOVED:/ { s = 1; next } /^[^ ]/ { s = 0 } s { for (i = 1; i <= NF; i++) { sub(/\*$/, "", $i); print $i } }' "$1" | sort; }
removes_of() { awk '/^[0-9]+ upgraded, .* to remove and [0-9]+ not upgraded\.$/ { print $(NF - 6); exit }' "$1"; }
guard_removals() {
  what="${2:-the full upgrade}"
  for name in $(removed_of "$1"); do
    base="${name%%:*}"
    why=""
    case "$base" in
      docker-ce|docker-ce-cli|containerd.io|docker-*-plugin|docker.io|samba*|cifs-utils|mergerfs|ntfs-3g|udevil|smartmontools|parted|net-tools|wget|curl|unzip|git|openssh-*|sudo|systemd*|dbus|ifupdown|network-manager|netplan.io|dhcpcd|ca-certificates|linux-image*|grub*|shim*|initramfs-tools|apt|dpkg|libc6)
        why="protected" ;;
      *) case "$(dpkg-query -W -f='${Essential} ${Priority}\n' "$base" 2> /dev/null || true)" in "yes "*|*" required") why="essential or required, as dpkg says" ;; esac ;;
    esac
    [ -z "$why" ] || { AUTOCLASS=guard; echo "STOP: $what would remove $name, which is $why. The upgrade has begun. DO NOT UNDO ANYTHING. Ask for help, with $1. What apt, dpkg and the scripts of the packages printed is in the log of the unit, $CASAOS_OSU_DIR/output.log (the page shows the end of it); what apt did is in /var/log/apt/history.log, and dpkg's own steps are in /var/log/dpkg.log: send the last 100 lines of each."; exit 1; }
  done
}
help="The upgrade has begun: do not undo anything, ask for help. What apt, dpkg and the scripts of the packages printed is in the log of the unit, $CASAOS_OSU_DIR/output.log (the page shows the end of it); what apt did is in /var/log/apt/history.log, and dpkg's own steps are in /var/log/dpkg.log: send the last 100 lines of each."
dpkgstate() { cksum < /var/lib/dpkg/status; ls -A /var/lib/dpkg/updates 2> /dev/null | sort; }
echo "Block F: mending what an interrupted upgrade left half done."
for unit in apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service unattended-upgrades.service; do
  if [ "$(systemctl is-active "$unit" 2>/dev/null || true)" = active ]; then systemctl stop "$unit"; fi
  [ "$(systemctl is-active "$unit" 2>/dev/null || true)" != active ] || { AUTOCLASS=busy; echo "STOP: $unit is still running: stop it (systemctl stop $unit), then run this block again."; exit 1; }
done
psout="$(ps -eo comm=,args= 2> /dev/null)" || { AUTOCLASS=tools; echo "STOP: ps did not answer, so the processes cannot be looked at for a package manager. If ps is not installed: apt-get install procps   then run this block again."; exit 1; }
busy="$(printf '%s\n' "$psout" | awk '
$1 == "apt" || $1 == "apt-get" || $1 == "aptitude" || $1 == "apt.systemd.dai" { $1 = $1; print substr($0, 1, 120); exit }
$1 == "dpkg" { for (i = 2; i <= NF; i++) if ($i ~ /^(-i|-r|-P|--install|--configure|--unpack|--remove|--purge|--triggers-only)$/) { $1 = $1; print substr($0, 1, 120); exit } }
$2 ~ /\/unattended-upgrade$/ || ($2 ~ /(^|\/)python[0-9.]*$/ && $3 ~ /\/unattended-upgrade$/) { $1 = $1; print substr($0, 1, 120); exit }
' | tr -cd '\040-\176')"
[ -z "$busy" ] || { AUTOCLASS=busy; echo "STOP: a package manager is running (the process list says: $busy): wait until it ends (if it is the daily job of apt: systemctl stop apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service unattended-upgrades.service), then run this block again. The upgrade has begun: do not undo anything."; exit 1; }
[ -e "$BK/expected-removed.txt" ] || : > "$BK/expected-removed.txt"
cfg=0
dpkg --configure -a --force-confdef --force-confold || cfg=$?
[ "$cfg" = 0 ] || echo "dpkg could not configure everything that is half done (it ended with $cfg; what it printed is above, in the log of the unit): the repair that follows is what can mend it."
recover="$BK/recover-$CASAOS_OSU_ATTEMPT.txt"
aptq -s -f install > "$recover" 2>&1 || { AUTOCLASS=apt_failed; echo "STOP: apt cannot work out the repair: see $recover. $help"; exit 1; }
[ -n "$(removes_of "$recover")" ] || { AUTOCLASS=apt_failed; echo "STOP: apt printed no summary line: see $recover. $help"; exit 1; }
[ "$(removed_of "$recover" | awk 'END { print NR }')" = "$(removes_of "$recover")" ] || { AUTOCLASS=apt_failed; echo "STOP: the packages that apt lists as removed are not as many as its summary says: see $recover. $help"; exit 1; }
if grep -q '^The following packages will be DOWNGRADED:' "$recover" || grep -Eq ' [0-9]+ downgraded, ' "$recover"; then AUTOCLASS=plan; echo "STOP: apt would downgrade packages (a pin over 1000, a package on hold, a package from outside Debian): see $recover. $help"; exit 1; fi
guard_removals "$recover" "the repair"
for name in $(removed_of "$recover"); do
  grep -qxF -- "$name" "$BK/expected-removed.txt" || { AUTOCLASS=guard; echo "STOP: the repair would remove $name, which the plan does not name: do not undo anything, ask for help, with $recover. What apt, dpkg and the scripts of the packages printed is in the log of the unit, $CASAOS_OSU_DIR/output.log (the page shows the end of it); what apt did is in /var/log/apt/history.log, and dpkg's own steps are in /var/log/dpkg.log: send the last 100 lines of each."; exit 1; }
done
if ! aptq -f install; then
  [ "$cfg" = 0 ] || { AUTOCLASS=dpkg_broken; echo "STOP: dpkg could not configure what is half done, and apt could not repair it either. Do not undo anything: ask for help. What apt, dpkg and the scripts of the packages printed is in the log of the unit, $CASAOS_OSU_DIR/output.log (the page shows the end of it); what apt did is in /var/log/apt/history.log, and dpkg's own steps are in /var/log/dpkg.log: send the last 100 lines of each."; exit 1; }
  { AUTOCLASS=apt_failed; echo "STOP: apt could not repair the packages. Do not undo anything: ask for help. What apt, dpkg and the scripts of the packages printed is in the log of the unit, $CASAOS_OSU_DIR/output.log (the page shows the end of it); what apt did is in /var/log/apt/history.log, and dpkg's own steps are in /var/log/dpkg.log: send the last 100 lines of each."; exit 1; }
fi
audit="$(dpkg --audit 2>&1)" && [ -z "$audit" ] || { AUTOCLASS=dpkg_broken; echo "STOP: dpkg is not quiet after the repair: dpkg --audit says what is left (it is in the log of the unit). Do not undo anything: ask for help. What apt, dpkg and the scripts of the packages printed is in the log of the unit, $CASAOS_OSU_DIR/output.log (the page shows the end of it); what apt did is in /var/log/apt/history.log, and dpkg's own steps are in /var/log/dpkg.log: send the last 100 lines of each."; exit 1; }
echo "Block F done."
