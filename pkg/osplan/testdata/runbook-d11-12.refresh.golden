now="$(srchash)"
[ "$now" = '35d17f59fd0705980471e5e52dcf6f54e2292d8b14e245051b88f45539ebcb8a' ] || { AUTOCLASS=plan; echo "STOP: the sources of apt are not the ones the refresh was started from: something changed them. Nothing has been changed by this block."; exit 1; }
