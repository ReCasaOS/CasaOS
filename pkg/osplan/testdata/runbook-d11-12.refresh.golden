removed_of() { awk '/^The following packages will be REMOVED:/ { s = 1; next } /^[^ ]/ { s = 0 } s { for (i = 1; i <= NF; i++) { sub(/\*$/, "", $i); print $i } }' "$1" | sort; }
removes_of() { awk '/^[0-9]+ upgraded, .* to remove and [0-9]+ not upgraded\.$/ { print $(NF - 6); exit }' "$1"; }
guard_removals() {
  what="${2:-the full upgrade}"
  for name in $(removed_of "$1"); do
    base="${name%%:*}"
    why=""
    case "$base" in
      docker-ce|docker-ce-cli|containerd.io|docker-*-plugin|docker.io|samba*|cifs-utils|mergerfs|ntfs-3g|udevil|smartmontools|parted|net-tools|wget|curl|unzip|git|openssh-*|sudo|systemd*|dbus|ifupdown|network-manager|netplan.io|dhcpcd|ca-certificates|linux-image*|grub*|shim*|initramfs-tools|apt|dpkg|libc6)
        why="protected" ;;
      *) case "$(dpkg-query -W -f='${Essential} ${Priority}\n' "$base" 2> /dev/null || true)" in "yes "*|*" required") why="essential or required, as dpkg says" ;; esac ;;
    esac
    [ -z "$why" ] || { AUTOCLASS=guard; echo "STOP: $what would remove $name, which is $why. The refresh stops here, and the unit puts the machine back. Ask for help, with $1. What apt, dpkg and the scripts of the packages printed is in the log of the unit, $CASAOS_OSU_DIR/output.log (the page shows the end of it); what apt did is in /var/log/apt/history.log, and dpkg's own steps are in /var/log/dpkg.log: send the last 100 lines of each."; exit 1; }
  done
}
help="The refresh stops here: the unit puts the sources and the timers back, and finishes what dpkg left half done. Do not undo anything by hand, and ask for help if the machine is not as it was. What apt, dpkg and the scripts of the packages printed is in the log of the unit, $CASAOS_OSU_DIR/output.log (the page shows the end of it); what apt did is in /var/log/apt/history.log, and dpkg's own steps are in /var/log/dpkg.log: send the last 100 lines of each."
no_removals() {
  for name in $(removed_of "$1"); do
    AUTOCLASS=plan; echo "STOP: the current release wants to remove $name: use the manual path or the packages window, which show what goes and ask first. The refresh removes nothing: see $1."
    exit 1
  done
}
