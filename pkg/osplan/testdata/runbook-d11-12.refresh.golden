# ===== blocks/rdone.sh
# casaos-os-upgrade rdone 6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13
set -eu
LC_ALL=C; export LC_ALL
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
AUTOCLASS=unknown
osu_exit() { rc=$?; [ "$rc" -eq 0 ] || printf '%s\n' "$AUTOCLASS" > "${CASAOS_OSU_DIR:-/nonexistent}/stop-class"; }
trap osu_exit EXIT
[ "${CASAOS_OSU_RUN:-}" = '6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13' ] && grep -q 'casaos-os-upgrade\.service' /proc/self/cgroup || { AUTOCLASS=unit; echo "STOP: this block belongs to the upgrade unit of the dashboard and runs only there, with the confirmation of the owner baked in: to continue by hand use manual-runbook.sh of the run."; exit 1; }
BK=/var/backups/casaos-os-upgrade-refresh-6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13
[ ! -e "$BK/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over (block 8 ended: done-after is in $BK): there is nothing more to run in this text."; exit 1; }
for fin in /var/backups/casaos-os-upgrade-*; do
  [ ! -e "$fin/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over for this machine: the plan whose folder is $fin took it to the end (block 8 ended: done-after is there), and there is nothing more to run in this text."; exit 1; }
done
grep -q '^VERSION_CODENAME=bullseye$' /etc/os-release || { AUTOCLASS=identity; echo "STOP: this machine is not Debian 11 (bullseye) any more: the refresh brings the release that the machine runs up to its last state, and this machine runs another."; exit 1; }
[ -e "$BK/done-rupgrade" ] || { AUTOCLASS=integrity; echo "STOP: the block before this one (rupgrade) did not end: the refresh does not go on without it (ls $BK shows how far it got)."; exit 1; }
mkdir -p -m 700 "$BK"; chmod 700 "$BK"
srchash() {
  nl="$(printf '\nx')"; nl="${nl%x}"
  ( cd /etc/apt
  for f in sources.list sources.list.d/*; do
    [ -f "$f" ] || continue
    case "$f" in
      sources.list) ;;
      sources.list.d/*)
        name="${f#sources.list.d/}"
        case "$name" in *"$nl"*) continue ;; esac
        printf '%s\n' "$name" | grep -Eq '^[A-Za-z0-9_:-][A-Za-z0-9_:.-]*\.(list|sources)$' || continue ;;
    esac
    n="$(wc -c < "$f")"
    printf '%s\0%s\0' "$f" "$((n))"
    cat "$f"
    printf '\0'
  done ) | sha256sum | awk '{ print $1 }'
}
echo "Block R3: the sources and the timers are put back."
sh "$BK/restore-sources.sh" || { AUTOCLASS=integrity; echo "STOP: the restore script could not put the sources back: see what it printed above. The copy of /etc/apt that block R1 made is in $BK/apt-orig."; exit 1; }
now="$(srchash)"
[ "$now" = '35d17f59fd0705980471e5e52dcf6f54e2292d8b14e245051b88f45539ebcb8a' ] || { AUTOCLASS=integrity; echo "STOP: the sources of apt are not what they were before the refresh, though they were put back from the copy: their hash is $now. Look at /etc/apt by hand: the copy of it that block R1 made is in $BK."; exit 1; }
# the timers, as they were (block R0 wrote them down)
TS=/var/backups/casaos-os-upgrade-timers.state
if [ -f "$TS" ]; then
  while read -r unit state; do
    if [ "$state" = active ]; then systemctl start "$unit"; fi
  done < "$TS"
else
  echo "$TS is not there, so no timer of apt is started: if they were running before the hop, start them: systemctl start apt-daily.timer apt-daily-upgrade.timer"
