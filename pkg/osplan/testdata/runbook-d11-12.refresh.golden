  [ "$(removed_of "$BK/repair.txt" | awk 'END { print NR }')" = "$(removes_of "$BK/repair.txt")" ] || { AUTOCLASS=apt_failed; echo "STOP: the packages that apt lists as removed are not as many as its summary says: see $BK/repair.txt. $help"; exit 1; }
