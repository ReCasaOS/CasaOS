cat > "$BK/restore-sources.sh" <<'CASAOS_EOF'
#!/bin/sh
# Puts /etc/apt/sources.list and sources.list.d back as they were before the refresh wrote its own.
# The copy of /etc/apt that the refresh made is in apt-orig, next to this file; it is put aside (apt-orig.restored.<number>) when the sources are back.
set -eu
LC_ALL=C; export LC_ALL
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
case "$0" in */*) HERE="${0%/*}" ;; *) HERE=. ;; esac
APT_ETC="${APT_ETC:-/etc/apt}"
if [ -e "$HERE/begun-upgrade" ] || [ -e "$HERE/done-minimal" ]; then echo "STOP: the upgrade has begun (block 5 was started): putting Debian 11's sources back now would leave Debian 12 packages on Debian 11 sources. Do not restore anything. Only forward: finish with dpkg --configure -a, then apt-get -f install, then block 6 and the blocks after it (the table at the end of the runbook has the exact commands)."; exit 1; fi
[ -d "$HERE/apt-orig" ] || { echo "STOP: $HERE/apt-orig is not there: nothing to restore from."; exit 1; }
rm -f "$APT_ETC"/sources.list.d/*.list "$APT_ETC"/sources.list.d/*.sources "$APT_ETC"/sources.list.d/*.casaos-paused "$APT_ETC"/sources.list.d/*.casaos-new "$APT_ETC/sources.list.casaos-new"
if [ -e "$HERE/apt-orig/sources.list" ]; then cp -a "$HERE/apt-orig/sources.list" "$APT_ETC/sources.list"; else rm -f "$APT_ETC/sources.list"; fi
if [ -d "$HERE/apt-orig/sources.list.d" ]; then cp -a "$HERE/apt-orig/sources.list.d/." "$APT_ETC/sources.list.d/"; fi
rm -f "$HERE/done-sources" "$HERE/done-download"
mv "$HERE/apt-orig" "$HERE/apt-orig.restored.$$"
echo "The sources are back as they were."
if [ -z "${CASAOS_NO_UPDATE:-}" ]; then apt-get update || echo "apt-get update did not go through (apt-get update does not wait for a lock: another package manager may hold it): run it again when it is free or the network is back."; fi
CASAOS_EOF
sh -n "$BK/restore-sources.sh" || { AUTOCLASS=integrity; echo "STOP: the restore script was damaged on its way here: it is not shell. Nothing is changed in /etc/apt. Start the refresh again."; exit 1; }
[ "$(sha256sum < "$BK/restore-sources.sh" | awk '{ print $1 }')" = '574a7cf6284241dd01d93a91a3f49a12a0fe4a3c5f1513c402aa1d9c5d7d365f' ] || { AUTOCLASS=integrity; echo "STOP: the restore script is not the one of this text: it was changed on its way here. Nothing is changed in /etc/apt. Start the refresh again."; exit 1; }
rm -rf "$BK/apt-orig.new"
cp -a "$APT_ETC" "$BK/apt-orig.new"
mv -f "$BK/apt-orig.new" "$BK/apt-orig"
: > "$BK/expected-removed.txt"
# the sources of the refresh: the machine's own, each under a new name first, read back and compared with the hash that was made of them, and put in place when all are right
(
umask 022
cat > "$APT_ETC/sources.list.casaos-new" <<'CASAOS_EOF'
deb http://deb.debian.org/debian bullseye main
deb-src http://deb.debian.org/debian bullseye main
deb http://archive.debian.org/debian-security bullseye-security main
deb-src http://archive.debian.org/debian-security bullseye-security main
deb http://deb.debian.org/debian bullseye-updates main
deb-src http://deb.debian.org/debian bullseye-updates main
CASAOS_EOF
)
gh() { n="$(wc -c < "$2")"; printf '%s\0%s\0' "$1" "$((n))"; cat "$2"; printf '\0'; }
written="$({ gh 'sources.list' "$APT_ETC/sources.list.casaos-new"; } | sha256sum | awk '{ print $1 }')"
echo "The plan's hash of the sources it wrote for apt: 146ccde4b5301a857252179fc81e5dfd7256b7882ca095414952becfc9f5b099"
[ "$written" = '146ccde4b5301a857252179fc81e5dfd7256b7882ca095414952becfc9f5b099' ] || { AUTOCLASS=plan; echo "STOP: the files written for apt are not the plan's: their hash is $written. The text was changed on its way here (a console that retypes what it is given can do that, and so can a bash without bracketed paste, which takes a TAB in a comment line of the sources for completion: type sh first, then paste this block again). Nothing is in place yet: sh $BK/restore-sources.sh   then run this block again, or ask for a new plan."; exit 1; }
mv -f "$APT_ETC/sources.list.d/docker.list" "$APT_ETC/sources.list.d/docker.list.casaos-paused"
mv -f "$APT_ETC/sources.list.casaos-new" "$APT_ETC/sources.list"
placed="$({ gh 'sources.list' "$APT_ETC/sources.list"; } | sha256sum | awk '{ print $1 }')"
[ "$placed" = '146ccde4b5301a857252179fc81e5dfd7256b7882ca095414952becfc9f5b099' ] || { AUTOCLASS=plan; echo "STOP: the files now in /etc/apt are not the ones that were written: their hash is $placed. A mv that asks a question instead of replacing (an alias such as mv -i) leaves the old file. The sources may be half in place: sh $BK/restore-sources.sh   puts them back; then run this block again, in a plain sh."; exit 1; }
rc=0
aptq update --error-on=any > "$BK/update.txt" 2>&1 || rc=$?
cat "$BK/update.txt"
if [ "$rc" != 0 ]; then
  if grep -Eq 'must be accepted explicitly before updates for this repository can be applied|changed its .(Origin|Label|Suite|Version|Codename). value' "$BK/update.txt"; then
    AUTOCLASS=identity; echo "STOP: apt refuses a repository whose release information changed (apt says: This must be accepted explicitly before updates for this repository can be applied): the owner says whether the change is wanted, and starts the refresh again with that said. Nothing has been installed or removed."; exit 1
  fi
  AUTOCLASS=network; echo "STOP: apt-get update does not go through with the sources of the refresh: the network, a mirror, or the lock of the lists held by another package manager (apt-get update does not wait for a lock): see what it printed above. Nothing has been installed or removed."; exit 1
fi
: > "$BK/done-rsources"
echo "Block R1 done."
