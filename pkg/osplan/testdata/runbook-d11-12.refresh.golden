rm -f "$TS"
wants=no
why=none
if [ -e /var/run/reboot-required ]; then
  wants=yes
  why=reboot-required
else
  dpkg-query -W -f='${db:Status-Abbrev} ${Package} ${Version}\n' 'linux-image-*' 2> /dev/null | awk '$1 ~ /^.i/ { print $2, $3 }' | sort > "$BK/kernels-after.txt" || true
