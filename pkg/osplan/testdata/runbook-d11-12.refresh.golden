# ===== blocks/rcheck.sh
# casaos-os-upgrade rcheck 6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13
set -eu
LC_ALL=C; export LC_ALL
PATH=/usr/sbin:/usr/bin:/sbin:/bin; export PATH
AUTOCLASS=unknown
osu_exit() { rc=$?; [ "$rc" -eq 0 ] || printf '%s\n' "$AUTOCLASS" > "${CASAOS_OSU_DIR:-/nonexistent}/stop-class"; }
trap osu_exit EXIT
[ "${CASAOS_OSU_RUN:-}" = '6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13' ] && grep -q 'casaos-os-upgrade\.service' /proc/self/cgroup || { AUTOCLASS=unit; echo "STOP: this block belongs to the upgrade unit of the dashboard and runs only there, with the confirmation of the owner baked in: to continue by hand use manual-runbook.sh of the run."; exit 1; }
BK=/var/backups/casaos-os-upgrade-refresh-6f9c3a52-1f7e-4c1b-9a47-2d8e5b0c7a13
[ ! -e "$BK/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over (block 8 ended: done-after is in $BK): there is nothing more to run in this text."; exit 1; }
for fin in /var/backups/casaos-os-upgrade-*; do
  [ ! -e "$fin/done-after" ] || { AUTOCLASS=identity; echo "STOP: the hop is over for this machine: the plan whose folder is $fin took it to the end (block 8 ended: done-after is there), and there is nothing more to run in this text."; exit 1; }
done
export DEBIAN_FRONTEND=noninteractive APT_LISTCHANGES_FRONTEND=none NEEDRESTART_SUSPEND=1
aptq() { apt-get -y -q -o Dpkg::Use-Pty=0 -o DPkg::Lock::Timeout=300 -o Acquire::Retries=3 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"; }
echo "Block R0: can the old release be brought up to date? Nothing is changed but the timers of apt."
[ "$(id -u)" = 0 ] || { AUTOCLASS=identity; echo "STOP: run this as root."; exit 1; }
[ "$(hostname)" = 'testbox' ] || { AUTOCLASS=identity; echo "STOP: this machine is called $(hostname), which is not the machine that the refresh was started on: the text of this unit was written for another."; exit 1; }
grep -q '^VERSION_CODENAME=bullseye$' /etc/os-release || { AUTOCLASS=identity; echo "STOP: this machine is not Debian 11 (bullseye) any more: the refresh brings the release that the machine runs up to its last state, and this machine runs another."; exit 1; }
for d in /var/backups/casaos-os-upgrade-*; do
  if [ -e "$d/begun-upgrade" ] || [ -e "$d/done-minimal" ]; then
    AUTOCLASS=identity; echo "STOP: another plan of this machine has begun the upgrade of the packages ($d has begun-upgrade): Debian 11 and 12 are mixed there, and nothing in this text applies to it. Do not restore anything, and do not make another plan: finish that upgrade. Only forward: DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold   then:   DEBIAN_FRONTEND=noninteractive apt-get -s -f install   (read it first: a line that starts with Remv is a package that it would remove; if it is one that the plan does not name, or one that this text protects, do not go on and ask for help)   then:   DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -f install   then:   apt-get dist-upgrade until nothing is left, and restart. Or ask for help."
    exit 1
  fi
  if [ -e "$d/apt-orig" ]; then
    if [ -f "$d/restore-sources.sh" ]; then
      AUTOCLASS=identity; echo "STOP: block 3 of another plan of this machine began ($d/apt-orig is there), so the sources of apt may no longer be the ones that this plan was made from. Put them back first: sh $d/restore-sources.sh   (it puts the sources back as they were and takes apt-orig aside), then run this block again."
    else
      AUTOCLASS=identity; echo "STOP: block 3 of another plan of this machine began ($d/apt-orig is there), and $d/restore-sources.sh is not. apt-orig is the whole copy of /etc/apt that it made before it changed anything: compare it with /etc/apt, put back by hand what differs, rename apt-orig, then run this block again."
    fi
    exit 1
  fi
done
psout="$(ps -eo comm=,args= 2> /dev/null)" || { AUTOCLASS=tools; echo "STOP: ps did not answer, so the processes cannot be looked at for a package manager. If ps is not installed: apt-get install procps   then run this block again."; exit 1; }
busy="$(printf '%s\n' "$psout" | awk '
$1 == "apt" || $1 == "apt-get" || $1 == "aptitude" || $1 == "apt.systemd.dai" { $1 = $1; print substr($0, 1, 120); exit }
$1 == "dpkg" { for (i = 2; i <= NF; i++) if ($i ~ /^(-i|-r|-P|--install|--configure|--unpack|--remove|--purge|--triggers-only)$/) { $1 = $1; print substr($0, 1, 120); exit } }
$2 ~ /\/unattended-upgrade$/ || ($2 ~ /(^|\/)python[0-9.]*$/ && $3 ~ /\/unattended-upgrade$/) { $1 = $1; print substr($0, 1, 120); exit }
' | tr -cd '\040-\176')"
[ -z "$busy" ] || { AUTOCLASS=busy; echo "STOP: a package manager is running (the process list says: $busy): wait until it ends (if it is the daily job of apt: systemctl stop apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service unattended-upgrades.service), then run this block again. Nothing has been changed by this block."; exit 1; }
audit="$(dpkg --audit 2>&1)" && [ -z "$audit" ] || { AUTOCLASS=dpkg_broken; echo "STOP: dpkg is not quiet: it has a package that is half installed or half configured, or it cannot open its own database. dpkg --audit says: ${audit:-nothing, but it ended with an error}. Run: dpkg --configure -a   then start the refresh again. If dpkg cannot open its own database, ask for help."; exit 1; }
aptq check > /dev/null || { AUTOCLASS=dpkg_broken; echo "STOP: apt-get check finds a broken dependency, or could not get the lock of dpkg in 5 minutes (what it printed above says which): repair it, or wait for the other package manager, then start the refresh again."; exit 1; }
avail() { df -Pk "$1" | awk 'NR == 2 { print $4 }'; }
[ "$(avail /var/cache/apt/archives)" -ge 1572864 ] || { AUTOCLASS=disk; echo "STOP: /var/cache/apt/archives has less than 1.5 GB free. Free some room there (apt-get clean empties the cache of downloaded packages; remove what you do not need), then start the refresh again."; exit 1; }
[ "$(avail /)" -ge 2097152 ] || { AUTOCLASS=disk; echo "STOP: / has less than 2 GB free. Free some room there (apt-get clean empties the cache of downloaded packages; remove what you do not need), then start the refresh again."; exit 1; }
mkdir -p -m 700 "$BK"; chmod 700 "$BK"
dpkg-query -W -f='${db:Status-Abbrev} ${Package} ${Version}\n' 'linux-image-*' 2> /dev/null | awk '$1 ~ /^.i/ { print $2, $3 }' | sort > "$BK/kernels-before.txt" || true
TS=/var/backups/casaos-os-upgrade-timers.state
if [ -e "$TS" ]; then
  echo "$TS is there from an earlier run of this block (by this plan or by another): the state of the timers that it holds is the one of before the hop, and it is kept."
else
  ( umask 077; : > "$TS.$$" )
  for unit in apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service; do
    printf '%s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)" >> "$TS.$$"
  done
  if ! ln "$TS.$$" "$TS" 2> /dev/null; then
    if [ -e "$TS" ]; then
      echo "$TS was put in place by another run of this block while this one was reading the timers: the state of that run is the one that is kept."
    else
      echo "ln could not put $TS in place (a file system with no hard links, or no room for one more entry): the state that this run wrote down is kept by a rename instead."
      mv -f "$TS.$$" "$TS" || { rm -f "$TS.$$"; AUTOCLASS=disk; echo "STOP: the state of the timers could not be put in $TS (is the disk full: df -h /var/backups): without it the end of the refresh would start no timer. Free some room, then run this block again."; exit 1; }
    fi
  fi
  rm -f "$TS.$$"
fi
: > "$BK/done-timers"
sync
for unit in apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service; do
  if [ "$(systemctl is-active "$unit" 2>/dev/null || true)" = active ]; then systemctl stop "$unit"; fi
  [ "$(systemctl is-active "$unit" 2>/dev/null || true)" != active ] || { AUTOCLASS=busy; echo "STOP: $unit is still running: stop it (systemctl stop $unit), then run this block again."; exit 1; }
done
: > "$BK/done-rcheck"
echo "Block R0 done."
