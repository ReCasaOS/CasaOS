guard_removals "$BK/resim.txt"
no_removals "$BK/resim.txt"
aptq --download-only dist-upgrade -o APT::Get::Always-Include-Phased-Updates=true || { AUTOCLASS=network; echo "STOP: the download did not go through: the network, or a lock held by another package manager (see what apt printed above). Nothing has been installed or removed yet."; exit 1; }
